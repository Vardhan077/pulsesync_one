# Copy to .env and set unique, strong secrets before use. Never commit .env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://pulsesync:change-this-password@localhost:5432/pulsesync
POSTGRES_PASSWORD=change-this-password
ALLOW_JSON_FALLBACK=false
UPLOADS_DIR=./backend/uploads
MAX_AUDIO_UPLOAD_BYTES=262144000
AI_SERVICE_URL=http://localhost:8000/process
AI_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
MEDIA_SIGNING_SECRET=replace-with-another-random-secret-at-least-32-characters
PULSESYNC_API_TOKEN=
DASHBOARD_URL=http://localhost:5173
HUBSPOT_REDIRECT_URI=http://localhost:3001/api/integrations/hubspot/callback
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=
OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TOKEN_TTL_SECONDS=3600
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
DISABLE_ACOUSTIC_DIARIZATION=false
